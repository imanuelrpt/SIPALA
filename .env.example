#--------------------------------------------------------------------
# SIPALA - Environment Template
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS         : cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
# development | testing | production
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Wajib diisi (CodeIgniter 4 menolak baseURL kosong).
# Laragon otomatis membuat virtual host untuk folder di C:\laragon\www.
# Jika memakai `php spark serve`, ubah menjadi: http://localhost:8080/
# Untuk production set eksplisit, contoh: https://sipala.example.go.id/
app.baseURL = 'http://sipala.test/'
# Hilangkan index.php dari URL yang dihasilkan. Hapus/beri komentar baris ini
# bila server web Anda tidak mengaktifkan mod_rewrite / .htaccess.
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'

# Fitur SIPALA
sipala.registrationEnabled = true
sipala.emailVerification = false
sipala.captcha.enabled = false
sipala.captcha.provider = ''
sipala.captcha.siteKey = ''
sipala.captcha.secretKey = ''
sipala.loginMaxAttempts = 5
sipala.loginWindowMinutes = 15
sipala.complaintHourlyLimit = 5
sipala.sessionIdleMinutes = 120
sipala.uploadMaxSizeKB = 2048
sipala.uploadMaxFiles = 3

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = db_sipala
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Database khusus pengujian (phpunit)
database.tests.hostname = localhost
database.tests.database = db_sipala_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
# Jalankan: php spark key:generate
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# Biarkan kosong/komentar agar memakai default writable/session.
# session.savePath =
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false
cookie.prefix = ''
cookie.expires = 0
cookie.path = '/'
cookie.domain = ''
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# SECURITY (CSRF)
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# EMAIL (opsional, untuk lupa password di production)
#--------------------------------------------------------------------
# email.protocol = smtp
# email.SMTPHost = smtp.example.com
# email.SMTPUser = no-reply@example.go.id
# email.SMTPPass = rahasia
# email.SMTPPort = 587
# email.SMTPCrypto = tls
# email.fromEmail = no-reply@example.go.id
# email.fromName = 'SIPALA'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
